{
    "$schema": "vendor/pushinbr/pam-native/resources/pam-native.plugin.schema.json",
    "version": 1,
    "protocol": 1,
    "pamNative": {
        "minimum": "0.3.0",
        "maximumExclusive": "0.4.0"
    },
    "php": {
        "provider": "Pam\\MobileUi\\MobileUiPluginProvider"
    },
    "android": {
        "namespace": "dev.pam.mobileui",
        "minSdk": 26,
        "sourceDirs": [
            "android/src/main/kotlin"
        ],
        "resourceDirs": [
            "android/src/main/res"
        ],
        "manifest": "android/src/main/AndroidManifest.xml",
        "consumerRules": "android/consumer-rules.pro"
    },
    "views": [
        {
            "name": "pam.mobile_ui.host",
            "class": "dev.pam.mobileui.MobileUiHostFactory"
        },
        {
            "name": "pam.mobile_ui.icon",
            "class": "dev.pam.mobileui.MobileUiIconFactory"
        },
        {
            "name": "pam.mobile_ui.markdown",
            "class": "dev.pam.mobileui.MobileUiMarkdownFactory"
        },
        {
            "name": "pam.mobile_ui.horizontal_scroll",
            "class": "dev.pam.mobileui.MobileUiHorizontalScrollFactory"
        },
        {
            "name": "pam.mobile_ui.grid",
            "class": "dev.pam.mobileui.MobileUiGridFactory"
        }
    ]
}
