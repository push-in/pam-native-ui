{
    "name": "pushinbr/pam-native-ui",
    "description": "Beautiful, accessible native UI components for PAM Native: forms with two-way binding, sheets, lists and a PAM-branded light and dark theme.",
    "type": "pam-native-plugin",
    "license": "Apache-2.0",
    "keywords": [
        "android",
        "components",
        "forms",
        "ios",
        "mobile",
        "native",
        "pam",
        "php",
        "ui"
    ],
    "homepage": "https://github.com/push-in/pam-native-ui",
    "support": {
        "issues": "https://github.com/push-in/pam-native-ui/issues",
        "source": "https://github.com/push-in/pam-native-ui"
    },
    "require": {
        "php": "^8.5",
        "pushinbr/pam-native": "^1.52"
    },
    "autoload": {
        "psr-4": {
            "Pam\\NativeUi\\": "src/",
            "Pam\\MobileUi\\": "compat/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pam\\NativeUi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "pam-native": {
            "plugin": "pam-native.plugin.json"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.git",
            "/.github",
            "/docs/assets",
            "/examples",
            "/tests",
            "/vendor"
        ]
    }
}
