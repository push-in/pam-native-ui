{
    "name": "pushinbr/pam-mobile-ui",
    "description": "Official accessible native UI component library for PAM Native.",
    "type": "pam-native-plugin",
    "license": "Apache-2.0",
    "keywords": [
        "android",
        "components",
        "mobile",
        "native",
        "pam",
        "php",
        "ui"
    ],
    "homepage": "https://github.com/push-in/pam-mobile-ui-php",
    "support": {
        "issues": "https://github.com/push-in/pam-mobile-ui-php/issues",
        "source": "https://github.com/push-in/pam-mobile-ui-php"
    },
    "require": {
        "php": "^8.4",
        "pushinbr/pam-native": "^0.4.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Pam\\MobileUi\\": "src/"
        },
        "classmap": [
            "src/Generated/MaterialComponentFacades.php"
        ],
        "exclude-from-classmap": [
            "tests/fixtures/InternalComponentFacades.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pam\\MobileUi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "pam-native": {
            "plugin": "pam-native.plugin.json"
        }
    },
    "scripts": {
        "generate:legacy": "php tools/generate.php",
        "generate:material": "php tools/generate-material.php",
        "generate": [
            "@generate:legacy",
            "@generate:material"
        ],
        "audit:styles": "php tools/audit-styles.php --strict",
        "analyse": "tools/phpstan/vendor/bin/phpstan analyse --level=9 --no-progress --debug",
        "benchmark": "php benchmarks/php.php",
        "benchmark:material": "php benchmarks/material.php",
        "release:check": "php tools/release-check.php",
        "test:recipes": "php tests/recipe-matrix.php",
        "test:material": "php tests/material-matrix.php",
        "test:native-gates": "php tests/native-gate-matrix.php",
        "test:showcase": "php tools/validate-showcase.php",
        "test:public-surface": "php tests/public-surface.php",
        "test": "php tests/theme-runtime.php",
        "verify": [
            "@generate",
            "@audit:styles",
            "@analyse",
            "@test:recipes",
            "@test:material",
            "@test:public-surface",
            "@test:native-gates",
            "@benchmark:material",
            "@test",
            "@test:showcase",
            "@release:check"
        ]
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    }
}
