<?php

declare(strict_types=1);

namespace Pam\NativeUi\Components;

use Pam\Native\Attributes\Action;
use Pam\Native\Attributes\Event;
use Pam\Native\Attributes\Prop;
use Pam\Native\Attributes\Tag;
use Pam\Native\Component;
use Pam\NativeUi\Support\Options;

/**
 * In-page tab bar with an underline indicator (Material 3 primary tabs).
 * Render each panel with `p-if` on the bound value. For app-level tabs use
 * PAM Native's tab navigator.
 *
 * <p-tabs p-model="$tab" :options="['overview' => 'Overview', 'activity' => 'Activity']" />
 */
#[Tag('p-tabs')]
#[Event('model', 'mixed')]
#[Event('change', 'mixed')]
final class Tabs extends Component
{
    public function __construct(
        #[Prop(immutable: false)] public string|int|null $modelValue = null,
        #[Prop(immutable: false)] public array $options = [],
        #[Prop(immutable: false)] public bool $scrollable = false,
    ) {
    }

    /** @return list<array<string, mixed>> */
    public function rows(): array
    {
        return Options::normalize($this->options);
    }

    #[Action]
    public function choose(string|int|float|bool $value): void
    {
        if (Options::same($value, $this->modelValue) || !(is_string($value) || is_int($value))) {
            return;
        }
        $this->modelValue = $value;
        $this->emit('model', $value);
        $this->emit('change', $value);
    }

    public function selected(mixed $value): bool
    {
        return Options::same($value, $this->modelValue);
    }
}
?>

<template language="2">
    <Column class="root">
        <Row class="tabs" accessibilityRole="tablist">
            <Pressable
                p-for="$option in rows()"
                :key="$option['key']"
                class="tab"
                accessibilityRole="tab"
                :accessibilityLabel="$option['label']"
                :accessibilitySelected="selected($option['value'])"
                :disabled="$option['disabled']"
                @press="choose($option['value'])"
            >
                <Text :class="selected($option['value']) ? 'label label-on' : 'label'" numberOfLines="1">{{ $option['label'] }}</Text>
                <View :class="selected($option['value']) ? 'indicator indicator-on' : 'indicator'" />
            </Pressable>
        </Row>
        <View class="rule" />
    </Column>
</template>

<style scoped>
    .root { width: 100%; }
    .tabs { flex-direction: row; }
    .tab { flex: 1; min-height: 48px; align-items: center; justify-content: center; padding: 0 12px; }
    .tab:pressed { background-color: var(--p-surface-pressed); }
    .label { font-size: 15px; line-height: 20px; font-weight: 500; color: var(--p-text-muted); }
    .label-on { font-weight: 600; color: var(--p-accent-text); }
    .indicator { position: absolute; bottom: 0; left: 16px; right: 16px; height: 3px; border-top-left-radius: 3px; border-top-right-radius: 3px; opacity: 0; transform: scaleX(0.4); transition: opacity 180ms ease-out, transform 220ms cubic-bezier(0.2, 0, 0, 1); }
    .indicator-on { opacity: 1; transform: scaleX(1); background-color: var(--p-accent); }
    .rule { height: 1px; background-color: var(--p-border); }

    @media (prefers-color-scheme: dark) {
        .tab:pressed { background-color: var(--p-surface-pressed-dark); }
        .label { color: var(--p-text-muted-dark); }
        .label-on { color: var(--p-accent-text-dark); }
        .indicator-on { background-color: var(--p-accent-dark); }
        .rule { background-color: var(--p-border-dark); }
    }

    @media (prefers-reduced-motion: reduce) {
        .indicator { transition: none; }
    }
</style>
