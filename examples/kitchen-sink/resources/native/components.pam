<AppScreen title="Components" subtitle="A complete native Material catalog">
    <template #actions>
        <p-icon-btn class="w-12 h-12 rounded-full text-primary" color="primary" variant="text" on:press="back" accessibilityLabel="Open component navigation">
            <p-icon icon="menu" color="primary" />
        </p-icon-btn>
    </template>

    <p-card class="p-5 rounded-3xl bg-primary">
        <p-card-item>
            <p-col class="gap-2">
                <p-chip variant="tonal"><p-text>Native design system</p-text></p-chip>
                <p-text size="2xl" class="text-white">Build beautifully.</p-text>
                <p-text size="md" class="w-full text-white">Every PAM component, rendered by UIKit and Android with the same expressive Material language.</p-text>
            </p-col>
        </p-card-item>
        <p-card-actions class="gap-2">
            <p-chip><p-icon icon="widgets" /><p-text>Curated mobile</p-text></p-chip>
            <p-chip><p-icon icon="palette" /><p-text>Themes</p-text></p-chip>
        </p-card-actions>
    </p-card>

    <p-slide-group>
        <p-slide-group-item value="actions"><p-chip variant="tonal"><p-text>Actions</p-text></p-chip></p-slide-group-item>
        <p-slide-group-item value="forms"><p-chip><p-text>Forms</p-text></p-chip></p-slide-group-item>
        <p-slide-group-item value="navigation"><p-chip><p-text>Navigation</p-text></p-chip></p-slide-group-item>
        <p-slide-group-item value="data"><p-chip><p-text>Data</p-text></p-chip></p-slide-group-item>
        <p-slide-group-item value="feedback"><p-chip><p-text>Feedback</p-text></p-chip></p-slide-group-item>
        <p-slide-group-item value="overlays"><p-chip><p-text>Overlays</p-text></p-chip></p-slide-group-item>
        <p-slide-group-item value="layout"><p-chip><p-text>Layout</p-text></p-chip></p-slide-group-item>
    </p-slide-group>

    <p-banner class="rounded-2xl">
        <p-banner-text>
            <p-text size="sm">Manual UIKit and Android implementations</p-text>
            <p-text class="ui-text-muted">No Vue runtime, metadata importer or v-* tags.</p-text>
        </p-banner-text>
        <p-banner-actions>
            <p-chip action="success"><p-text>MD3</p-text></p-chip>
        </p-banner-actions>
    </p-banner>

    <p-col class="gap-3">
        <p-text size="xl">Buttons</p-text>
        <p-text class="ui-text-muted">Variants</p-text>
        <p-card class="p-4 rounded-3xl">
            <p-row class="gap-2">
                <p-btn variant="elevated"><p-text>Elevated</p-text></p-btn>
                <p-btn><p-text>Filled</p-text></p-btn>
                <p-btn variant="tonal"><p-text>Tonal</p-text></p-btn>
            </p-row>
            <p-row class="gap-2">
                <p-btn variant="outline"><p-text>Outlined</p-text></p-btn>
                <p-btn variant="text"><p-text>Text</p-text></p-btn>
                <p-btn variant="plain"><p-text>Plain</p-text></p-btn>
            </p-row>
        </p-card>
        <p-text class="ui-text-muted">Colors</p-text>
        <p-card class="p-4 rounded-3xl">
            <p-row class="gap-2">
                <p-btn color="primary"><p-text>Primary</p-text></p-btn>
                <p-btn color="secondary"><p-text>Secondary</p-text></p-btn>
                <p-btn action="success"><p-text>Success</p-text></p-btn>
            </p-row>
            <p-row class="gap-2">
                <p-btn action="info"><p-text>Info</p-text></p-btn>
                <p-btn action="warning"><p-text>Warning</p-text></p-btn>
                <p-btn action="error"><p-text>Error</p-text></p-btn>
            </p-row>
        </p-card>
        <p-text class="ui-text-muted">Sizes and states</p-text>
        <p-card class="p-4 rounded-3xl">
            <p-row class="items-center gap-2">
                <p-btn size="xs"><p-text>XS</p-text></p-btn>
                <p-btn size="sm"><p-text>Small</p-text></p-btn>
                <p-btn size="md"><p-text>Default</p-text></p-btn>
            </p-row>
            <p-row class="items-center gap-2">
                <p-btn size="lg"><p-text>Large</p-text></p-btn>
                <p-btn size="xl"><p-text>XL</p-text></p-btn>
            </p-row>
            <p-row class="items-center gap-2">
                <p-btn disabled="true"><p-text>Disabled</p-text></p-btn>
                <p-btn loading="true"><p-text>Loading</p-text></p-btn>
                <p-icon-btn accessibilityLabel="Favorite"><p-icon icon="favorite" /></p-icon-btn>
                <p-fab size="sm"><p-icon icon="add" /></p-fab>
                <p-fab><p-icon icon="edit" /><p-text>Create</p-text></p-fab>
            </p-row>
        </p-card>
    </p-col>

    <p-col class="gap-3">
        <p-text size="xl">Surfaces</p-text>
        <p-text class="ui-text-muted">Variants, borders and elevation</p-text>
        <p-row class="gap-3">
            <p-card variant="elevated" elevation="8" class="p-4 rounded-2xl flex-1">
                <p-card-title>Elevated</p-card-title>
                <p-card-subtitle>Elevation 8</p-card-subtitle>
            </p-card>
            <p-card variant="tonal" class="p-4 rounded-2xl flex-1">
                <p-card-title>Tonal</p-card-title>
                <p-card-subtitle>Soft emphasis</p-card-subtitle>
            </p-card>
        </p-row>
        <p-row class="gap-3">
            <p-card variant="outline" border="true" class="p-4 rounded-lg flex-1">
                <p-card-title>Outlined</p-card-title>
                <p-card-subtitle>Border</p-card-subtitle>
            </p-card>
            <p-card variant="flat" class="p-4 rounded-none flex-1">
                <p-card-title>Flat</p-card-title>
                <p-card-subtitle>Square</p-card-subtitle>
            </p-card>
        </p-row>
        <p-row class="gap-2">
            <p-sheet elevation="0" class="p-3 rounded-xl"><p-text>0</p-text></p-sheet>
            <p-sheet elevation="1" class="p-3 rounded-xl"><p-text>1</p-text></p-sheet>
            <p-sheet elevation="2" class="p-3 rounded-xl"><p-text>2</p-text></p-sheet>
            <p-sheet elevation="4" class="p-3 rounded-xl"><p-text>4</p-text></p-sheet>
            <p-sheet elevation="8" class="p-3 rounded-xl"><p-text>8</p-text></p-sheet>
            <p-sheet elevation="12" class="p-3 rounded-xl"><p-text>12</p-text></p-sheet>
            <p-sheet elevation="16" class="p-3 rounded-xl"><p-text>16</p-text></p-sheet>
            <p-sheet elevation="24" class="p-3 rounded-xl"><p-text>24</p-text></p-sheet>
        </p-row>
    </p-col>

    <p-col class="gap-3">
        <p-text size="xl">Chips and badges</p-text>
        <p-text class="ui-text-muted">Variants, colors, sizes and selection</p-text>
        <p-card class="p-4 rounded-3xl">
            <p-chip-group value="filter">
                <p-chip value="filled"><p-text>Filled</p-text></p-chip>
                <p-chip value="tonal" variant="tonal"><p-text>Tonal</p-text></p-chip>
                <p-chip value="outlined" variant="outline"><p-text>Outlined</p-text></p-chip>
                <p-chip value="filter" selected="true"><p-icon icon="check" /><p-text>Selected</p-text></p-chip>
                <p-chip closable="true"><p-text>Closable</p-text></p-chip>
                <p-chip disabled="true"><p-text>Disabled</p-text></p-chip>
            </p-chip-group>
            <p-row class="items-center gap-3">
                <p-chip size="xs"><p-text>XS</p-text></p-chip>
                <p-chip size="sm" action="success"><p-text>Small</p-text></p-chip>
                <p-chip size="md" action="info"><p-text>Default</p-text></p-chip>
                <p-chip size="lg" action="warning"><p-text>Large</p-text></p-chip>
                <p-badge action="error"><p-text>8</p-text></p-badge>
                <p-avatar size="sm"><p-text>P</p-text></p-avatar>
                <p-avatar size="lg"><p-icon icon="person" /></p-avatar>
            </p-row>
        </p-card>
    </p-col>

    <p-col class="gap-3">
        <p-text size="xl">Feedback</p-text>
        <p-text class="ui-text-muted">Semantic colors and variants</p-text>
        <p-alert action="success" variant="tonal"><p-alert-title>Success</p-alert-title><p-text>Everything is ready to ship.</p-text></p-alert>
        <p-alert action="info" variant="outline"><p-alert-title>Information</p-alert-title><p-text>A useful contextual message.</p-text></p-alert>
        <p-alert action="warning" variant="tonal"><p-alert-title>Warning</p-alert-title><p-text>Review this choice before continuing.</p-text></p-alert>
        <p-alert action="error" variant="flat"><p-alert-title>Error</p-alert-title><p-text>Something needs your attention.</p-text></p-alert>
        <p-row class="gap-3 items-center">
            <p-progress-circular value="72" size="sm" />
            <p-progress-circular value="72" size="lg" />
            <p-progress-circular indeterminate="true" />
            <p-col class="flex-1 gap-2">
                <p-progress-linear value="34" />
                <p-progress-linear value="68" color="secondary" />
                <p-progress-linear indeterminate="true" />
            </p-col>
        </p-row>
    </p-col>

    <p-col class="gap-3">
        <p-text size="lg">Foundations</p-text>
        <p-card class="p-4 rounded-2xl">
            <p-card-item>
                <p-row class="items-center gap-3">
                    <p-avatar size="lg"><p-text>P</p-text></p-avatar>
                    <p-col class="flex-1 gap-1">
                        <p-card-title>PAM Material</p-card-title>
                        <p-card-subtitle>Native surfaces and typography</p-card-subtitle>
                    </p-col>
                    <p-badge action="success"><p-text>Ready</p-text></p-badge>
                </p-row>
            </p-card-item>
            <p-card-text>
                <p-text>Cards, sheets, alerts, banners, dividers and labels share semantic tokens.</p-text>
            </p-card-text>
        </p-card>
        <p-alert action="info" variant="tonal">
            <p-alert-title>Adaptive by default</p-alert-title>
            <p-text>Safe areas, density, themes, locale and RTL flow through every primitive.</p-text>
        </p-alert>
        <p-empty-state>
            <p-icon icon="inbox" />
            <p-text size="md">Purposeful empty states</p-text>
            <p-text class="ui-text-muted">With recovery actions and accessible descriptions.</p-text>
        </p-empty-state>
    </p-col>

    <p-col class="gap-3">
        <p-text size="lg">Actions and selection</p-text>
        <p-row class="gap-2">
            <p-btn><p-text>Filled</p-text></p-btn>
            <p-btn variant="tonal"><p-text>Tonal</p-text></p-btn>
            <p-btn variant="outline"><p-text>Outlined</p-text></p-btn>
        </p-row>
        <p-row class="gap-3 items-center">
            <p-fab accessibilityLabel="Create"><p-icon icon="add" /></p-fab>
            <p-icon-btn accessibilityLabel="Favorite"><p-icon icon="star" /></p-icon-btn>
            <p-chip closable="true"><p-text>Interactive chip</p-text></p-chip>
            <p-rating value="4" maximum="5" />
        </p-row>
        <p-btn-toggle value="{{ $selection }}">
            <p-btn value="native" on:press="selectNative"><p-text>Native</p-text></p-btn>
            <p-btn value="typed" on:press="selectTyped"><p-text>Typed</p-text></p-btn>
        </p-btn-toggle>
        <p-selection-control-group>
            <p-col class="gap-3">
                <p-checkbox checked="{{ $checked }}" on:change="toggle">
                    <p-label>Checkbox</p-label>
                </p-checkbox>
                <p-radio-group value="{{ $selection }}">
                    <p-radio value="native"><p-label>Android and iOS</p-label></p-radio>
                    <p-radio value="typed"><p-label>Typed protocol</p-label></p-radio>
                </p-radio-group>
                <p-switch checked="{{ $checked }}" on:change="toggle">
                    <p-label>Motion and haptics</p-label>
                </p-switch>
            </p-col>
        </p-selection-control-group>
    </p-col>

    <p-col class="gap-3">
        <p-text size="lg">Forms</p-text>
        <p-form>
            <p-text-field label="Project name" value="PAM UI" helper="Visible label and helper text" />
            <p-text-field label="Outlined" value="Native field" variant="outline" />
            <p-text-field label="Filled" value="Native field" variant="filled" />
            <p-text-field label="Compact" value="Dense control" density="compact" />
            <p-text-field label="Error" value="Invalid value" error="true" helper="This field needs attention" />
            <p-text-field label="Disabled" value="Unavailable" disabled="true" />
            <p-text-field label="Read only" value="Stable value" readonly="true" />
            <p-textarea label="Description" value="Native rendering without JavaScript." />
            <p-row class="gap-2">
                <p-number-input label="Instances" value="12" class="flex-1" />
                <p-otp-input label="Release code" value="4162" class="flex-1" />
            </p-row>
            <p-select label="Runtime" value="native" items="Native,Hybrid,Web" />
            <p-autocomplete label="Component" value="p-btn" items="p-btn,p-card,p-dialog,p-table" />
            <p-combobox label="Tags" value="material" items="material,native,typed" />
            <p-date-input label="Release date" value="2026-07-26" />
            <p-color-input label="Brand color" value="#4C8DFF" />
            <p-file-input label="Artifacts" />
            <p-file-upload>
                <p-file-upload-item><p-text>pam-mobile-ui.zip</p-text></p-file-upload-item>
            </p-file-upload>
            <p-messages><p-text class="ui-text-muted">Validation, drafts, server errors and autofill are native.</p-text></p-messages>
            <p-counter><p-text>24 / 120</p-text></p-counter>
        </p-form>
    </p-col>

    <p-col class="gap-3">
        <p-text size="xl">Selection controls</p-text>
        <p-card class="p-4 rounded-3xl">
            <p-selection-control-group>
                <p-row class="gap-4 items-center">
                    <p-checkbox checked="true"><p-label>Checked</p-label></p-checkbox>
                    <p-checkbox checked="false"><p-label>Empty</p-label></p-checkbox>
                    <p-checkbox indeterminate="true"><p-label>Mixed</p-label></p-checkbox>
                    <p-checkbox disabled="true"><p-label>Disabled</p-label></p-checkbox>
                </p-row>
                <p-radio-group value="primary">
                    <p-radio value="primary"><p-label>Selected</p-label></p-radio>
                    <p-radio value="secondary"><p-label>Unselected</p-label></p-radio>
                    <p-radio value="disabled" disabled="true"><p-label>Disabled</p-label></p-radio>
                </p-radio-group>
                <p-row class="gap-4 items-center">
                    <p-switch checked="true"><p-label>On</p-label></p-switch>
                    <p-switch checked="false"><p-label>Off</p-label></p-switch>
                    <p-switch checked="true" disabled="true"><p-label>Disabled</p-label></p-switch>
                </p-row>
            </p-selection-control-group>
        </p-card>
    </p-col>

    <p-col class="gap-3">
        <p-text size="lg">Progress and loading</p-text>
        <p-progress-linear value="{{ $range }}" />
        <p-row class="items-center gap-4">
            <p-progress-circular value="{{ $range }}" size="lg" />
            <p-slider value="{{ $range }}" on:change="changeRange" class="flex-1" />
        </p-row>
        <p-range-slider value="28" maximumValue="{{ $range }}" />
        <p-skeleton-loader class="h-24 rounded-2xl" />
        <p-col>
            <p-text class="ui-text-muted">Pull-to-refresh uses the platform indicator.</p-text>
        </p-col>
    </p-col>

    <p-col class="gap-3">
        <p-text size="lg">Disclosure and navigation</p-text>
        <p-breadcrumbs>
            <p-breadcrumbs-item><p-text>Studio</p-text></p-breadcrumbs-item>
            <p-breadcrumbs-divider><p-text>/</p-text></p-breadcrumbs-divider>
            <p-breadcrumbs-item><p-text>Components</p-text></p-breadcrumbs-item>
        </p-breadcrumbs>
        <p-tabs value="controls">
            <p-tab value="controls"><p-text>Controls</p-text></p-tab>
            <p-tab value="data"><p-text>Data</p-text></p-tab>
            <p-tab value="motion"><p-text>Motion</p-text></p-tab>
        </p-tabs>
        <p-expansion-panels>
            <p-expansion-panel value="performance">
                <p-expansion-panel-title><p-text>Native performance</p-text></p-expansion-panel-title>
                <p-expansion-panel-text><p-text>Diffed frames and UI-thread interactions.</p-text></p-expansion-panel-text>
            </p-expansion-panel>
            <p-expansion-panel value="accessibility">
                <p-expansion-panel-title><p-text>Accessibility</p-text></p-expansion-panel-title>
                <p-expansion-panel-text><p-text>TalkBack, VoiceOver, keyboard and reduced motion.</p-text></p-expansion-panel-text>
            </p-expansion-panel>
        </p-expansion-panels>
        <p-stepper value="2">
            <p-stepper-header>
                <p-stepper-item value="1"><p-text>Design</p-text></p-stepper-item>
                <p-stepper-item value="2"><p-text>Build</p-text></p-stepper-item>
                <p-stepper-item value="3"><p-text>Ship</p-text></p-stepper-item>
            </p-stepper-header>
        </p-stepper>
        <p-pagination value="2" length="5" />
        <p-btn-group>
            <p-btn variant="outline"><p-icon icon="format-align-left" /></p-btn>
            <p-btn variant="outline"><p-icon icon="format-align-center" /></p-btn>
            <p-btn variant="outline"><p-icon icon="format-align-right" /></p-btn>
        </p-btn-group>
        <p-window value="details">
            <p-window-item value="details"><p-sheet class="p-4 rounded-2xl"><p-text>Window item: details</p-text></p-sheet></p-window-item>
            <p-window-item value="activity"><p-sheet class="p-4 rounded-2xl"><p-text>Window item: activity</p-text></p-sheet></p-window-item>
        </p-window>
        <p-stepper-vertical value="2">
            <p-stepper-vertical-item value="1"><p-text>Choose a theme</p-text></p-stepper-vertical-item>
            <p-stepper-vertical-item value="2"><p-text>Customize components</p-text><p-stepper-vertical-actions /></p-stepper-vertical-item>
            <p-stepper-vertical-item value="3"><p-text>Publish release</p-text></p-stepper-vertical-item>
        </p-stepper-vertical>
    </p-col>

    <p-col class="gap-3">
        <p-text size="lg">Data display</p-text>
        <p-list>
            <p-list-subheader>Native packages</p-list-subheader>
            <p-list-item>
                <p-list-item-title>pushinbr/pam-mobile-ui</p-list-item-title>
                <p-list-item-subtitle>Material components</p-list-item-subtitle>
            </p-list-item>
            <p-list-item>
                <p-list-item-title>pushinbr/pam-native</p-list-item-title>
                <p-list-item-subtitle>Android + UIKit renderer</p-list-item-subtitle>
            </p-list-item>
        </p-list>
        <p-col>
            <p-row>
                <p-text class="flex-1">Gate</p-text>
                <p-text class="flex-1">Status</p-text>
            </p-row>
            <p-divider />
            <p-row>
                <p-text class="flex-1">Inventory</p-text>
                <p-chip action="success"><p-text>Verified</p-text></p-chip>
            </p-row>
        </p-col>
        <p-data-table items="Android,iOS,Composer" />
        <p-data-iterator items="Cards,Rows,Lists">
            <p-chip><p-text>Template-driven items</p-text></p-chip>
        </p-data-iterator>
        <p-infinite-scroll items="One,Two,Three" />
        <p-infinite-scroll items="A,B,C" />
        <p-timeline>
            <p-timeline-item><p-text>Authored spec</p-text></p-timeline-item>
            <p-timeline-item><p-text>Native render</p-text></p-timeline-item>
            <p-timeline-item><p-text>Release gates</p-text></p-timeline-item>
        </p-timeline>
        <p-treeview>
            <p-treeview-item path="/src"><p-text>src</p-text></p-treeview-item>
            <p-treeview-item path="/tests"><p-text>tests</p-text></p-treeview-item>
        </p-treeview>
        <p-item-group value="android">
            <p-item value="android"><p-card variant="tonal" class="p-3 rounded-xl"><p-text>Android</p-text></p-card></p-item>
            <p-item value="ios"><p-card variant="outline" class="p-3 rounded-xl"><p-text>iOS</p-text></p-card></p-item>
        </p-item-group>
    </p-col>

    <p-col class="gap-3">
        <p-text size="lg">Date, color and visualization</p-text>
        <p-calendar value="2026-07-26" />
        <p-date-picker value="2026-07-26">
            <p-date-picker-header><p-text>July 2026</p-text></p-date-picker-header>
            <p-date-picker-month />
        </p-date-picker>
        <p-time-picker value="19:30">
            <p-time-picker-clock />
            <p-time-picker-controls />
        </p-time-picker>
        <p-color-picker value="#4C8DFF">
            <p-color-picker-preview />
            <p-color-picker-canvas />
            <p-color-picker-swatches />
        </p-color-picker>
        <p-sparkline value="18,32,29,44,68,61,82" />
    </p-col>

    <p-col class="gap-3">
        <p-text size="lg">Layout and motion</p-text>
        <p-col>
            <p-row class="gap-2">
                <p-col class="flex-1"><p-sheet class="p-3 rounded-xl"><p-text>Column 1</p-text></p-sheet></p-col>
                <p-spacer />
                <p-col class="flex-1"><p-sheet class="p-3 rounded-xl"><p-text>Column 2</p-text></p-sheet></p-col>
            </p-row>
        </p-col>
        <p-col aspectRatio="16/9">
            <p-img source="https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=1200" alt="Mountain landscape" />
        </p-col>
        <p-col aspectRatio="16/9">
            <p-card class="p-4 rounded-2xl">
                <p-text>Responsive surface</p-text>
            </p-card>
        </p-col>
        <p-slide-group>
            <p-slide-group-item value="one"><p-chip><p-text>One</p-text></p-chip></p-slide-group-item>
            <p-slide-group-item value="two"><p-chip><p-text>Two</p-text></p-chip></p-slide-group-item>
        </p-slide-group>
        <p-carousel value="one" class="h-40">
            <p-carousel-item value="one"><p-card class="p-5"><p-text>Native page one</p-text></p-card></p-carousel-item>
            <p-carousel-item value="two"><p-card class="p-5"><p-text>Native page two</p-text></p-card></p-carousel-item>
        </p-carousel>
        <p-parallax>
            <p-img source="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=1200" alt="Forest" />
        </p-parallax>
        <p-transition name="fade">
            <p-sheet class="p-4 rounded-2xl"><p-text>Reduced-motion aware transition</p-text></p-sheet>
        </p-transition>
        <p-lazy>
            <p-col>
                <p-card class="p-4 rounded-2xl"><p-text>Lazy + hover surface</p-text></p-card>
            </p-col>
        </p-lazy>
    </p-col>

    <p-col class="gap-3">
        <p-text size="xl">Application shell</p-text>
        <p-col>
            <p-card variant="outline" class="rounded-3xl">
                <p-toolbar>
                    <p-toolbar-title>Workspace</p-toolbar-title>
                    <p-spacer />
                    <p-toolbar-items>
                        <p-icon-btn accessibilityLabel="Search"><p-icon icon="search" /></p-icon-btn>
                        <p-icon-btn accessibilityLabel="More options"><p-icon icon="more-vert" /></p-icon-btn>
                    </p-toolbar-items>
                </p-toolbar>
                <p-sheet class="p-4"><p-text>A complete native application surface</p-text></p-sheet>
            </p-card>
        </p-col>
        <p-card variant="outline" class="rounded-3xl">
            <p-app-bar>
                <p-app-bar-nav-icon><p-icon icon="menu" /></p-app-bar-nav-icon>
                <p-app-bar-title>Native workspace</p-app-bar-title>
                <p-icon-btn><p-icon icon="more-vert" /></p-icon-btn>
            </p-app-bar>
            <p-col>
                <p-col>
                    <p-list-item><p-list-item-title>Overview</p-list-item-title></p-list-item>
                    <p-list-item><p-list-item-title>Components</p-list-item-title></p-list-item>
                </p-col>
                <p-col>
                    <p-col><p-sheet class="p-5"><p-text>Adaptive content area</p-text></p-sheet></p-col>
                </p-col>
            </p-col>
            <p-row value="components">
                <p-btn value="home"><p-icon icon="home" /><p-text>Home</p-text></p-btn>
                <p-btn value="components"><p-icon icon="widgets" /><p-text>Components</p-text></p-btn>
                <p-btn value="settings"><p-icon icon="settings" /><p-text>Settings</p-text></p-btn>
            </p-row>
            <p-col><p-text class="ui-text-muted">PAM native design system</p-text></p-col>
        </p-card>
    </p-col>

    <p-col class="gap-3">
        <p-text size="xl">Component anatomy</p-text>
        <p-text class="ui-text-muted">Specialized views and composable building blocks</p-text>

        <p-card class="p-4 rounded-3xl">
            <p-card-title>Calendar anatomy</p-card-title>
            <p-calendar value="2026-07-26">
                <p-calendar-header><p-text>July 2026</p-text></p-calendar-header>
                <p-calendar-interval><p-text>09:00</p-text></p-calendar-interval>
                <p-calendar-day value="2026-07-26"><p-text>26</p-text></p-calendar-day>
            </p-calendar>
        </p-card>

        <p-card class="p-4 rounded-3xl">
            <p-card-title>Date picker views</p-card-title>
            <p-date-picker value="2026-07-26">
                <p-date-picker-header><p-text>Sunday, July 26</p-text></p-date-picker-header>
                <p-date-picker-controls />
                <p-date-picker-month />
                <p-date-picker-months />
                <p-date-picker-years />
            </p-date-picker>
        </p-card>

        <p-card class="p-4 rounded-3xl">
            <p-card-title>Color editing</p-card-title>
            <p-color-picker value="#4C8DFF">
                <p-color-picker-preview />
                <p-color-picker-canvas />
                <p-color-picker-edit />
                <p-color-picker-swatches />
            </p-color-picker>
        </p-card>

        <p-card class="p-4 rounded-3xl">
            <p-card-title>Picker and confirmation</p-card-title>
            <p-picker>
                <p-picker-title>Choose a release channel</p-picker-title>
                <p-list>
                    <p-list-group value="stable">
                        <p-list-subheader>Recommended</p-list-subheader>
                        <p-list-item><p-list-item-title>Stable</p-list-item-title></p-list-item>
                        <p-list-item><p-list-item-title>Preview</p-list-item-title></p-list-item>
                    </p-list-group>
                </p-list>
            </p-picker>
            <p-confirm-edit value="Stable">
                <p-text>Stable channel selected</p-text>
            </p-confirm-edit>
        </p-card>

        <p-card class="p-4 rounded-3xl">
            <p-card-title>Selection primitives</p-card-title>
            <p-row class="gap-3 items-center">
                <p-checkbox-btn checked="true" accessibilityLabel="Selected checkbox button" />
                <p-selection-control checked="true"><p-label>Custom selection control</p-label></p-selection-control>
            </p-row>
        </p-card>

        <p-card class="p-4 rounded-3xl">
            <p-card-title>Data strategies</p-card-title>
            <p-data-table-server items="Release,Status,Owner" />
            <p-divider />
            <p-data-table-virtual items="Android,iOS,Composer,GitHub" />
        </p-card>

        <p-card class="p-4 rounded-3xl">
            <p-card-title>Stepper window</p-card-title>
            <p-stepper value="2">
                <p-stepper-header>
                    <p-stepper-item value="1"><p-text>Design</p-text></p-stepper-item>
                    <p-stepper-item value="2"><p-text>Build</p-text></p-stepper-item>
                    <p-stepper-item value="3"><p-text>Release</p-text></p-stepper-item>
                </p-stepper-header>
                <p-stepper-window value="2">
                    <p-stepper-window-item value="1"><p-text>Theme and tokens</p-text></p-stepper-window-item>
                    <p-stepper-window-item value="2"><p-text>Native implementation</p-text></p-stepper-window-item>
                    <p-stepper-window-item value="3"><p-text>Distribution</p-text></p-stepper-window-item>
                </p-stepper-window>
                <p-stepper-actions />
            </p-stepper>
        </p-card>

        <p-card class="p-4 rounded-3xl">
            <p-card-title>Queued feedback</p-card-title>
            <p-snackbar-queue items="Build complete,Android artifact ready,iOS checks passed" />
        </p-card>

        <p-card class="p-4 rounded-3xl">
            <p-card-title>Overlay surface</p-card-title>
            <p-col aspectRatio="16/9">
                <p-sheet class="p-4 rounded-2xl">
                    <p-text>Content beneath the overlay</p-text>
                    <p-overlay open="false"><p-progress-circular indeterminate="true" /></p-overlay>
                </p-sheet>
            </p-col>
        </p-card>
    </p-col>

    <p-col class="gap-3">
        <p-text size="xl">Providers and validation</p-text>
        <p-theme-provider theme="light">
            <p-defaults-provider density="comfortable">
                <p-locale-provider locale="en-US">
                    <p-card variant="tonal" class="p-4 rounded-2xl">
                        <p-validation valid="true">
                            <p-field>
                                <p-field-label>Provider-scoped field</p-field-label>
                                <p-input value="Theme, defaults and locale" />
                                <p-messages><p-text>Valid and accessible</p-text></p-messages>
                            </p-field>
                        </p-validation>
                    </p-card>
                </p-locale-provider>
            </p-defaults-provider>
        </p-theme-provider>
    </p-col>

    <p-col class="gap-3">
        <p-text size="lg">Overlays</p-text>
        <p-row class="gap-2">
            <p-btn on:press="openDialog"><p-text>Dialog</p-text></p-btn>
            <p-btn variant="outline" on:press="openSheet"><p-text>Bottom sheet</p-text></p-btn>
            <p-tooltip text="Native tooltip"><p-icon-btn><p-icon icon="info" /></p-icon-btn></p-tooltip>
        </p-row>
        <p-menu>
            <p-btn><p-text>Menu</p-text></p-btn>
            <p-list><p-list-item><p-list-item-title>Menu item</p-list-item-title></p-list-item></p-list>
        </p-menu>
        <p-speed-dial>
            <p-fab><p-icon icon="add" /></p-fab>
            <p-icon-btn><p-icon icon="edit" /></p-icon-btn>
            <p-icon-btn><p-icon icon="share" /></p-icon-btn>
        </p-speed-dial>
        <p-snackbar open="true"><p-text>Native snackbar with live-region semantics.</p-text></p-snackbar>
    </p-col>

    <p-dialog open="{{ $dialogOpen }}" on:event="closeDialog">
        <p-card>
            <p-card-title>Production dialog</p-card-title>
            <p-card-text><p-text>Focus trapping, Back, scrim and motion are platform-owned.</p-text></p-card-text>
            <p-card-actions><p-btn on:press="closeDialog"><p-text>Close</p-text></p-btn></p-card-actions>
        </p-card>
    </p-dialog>

    <p-bottom-sheet open="{{ $sheetOpen }}" snapPoints="35,65" snapToIndex="1" on:event="closeSheet">
        <p-list-item><p-list-item-title>Inspect component</p-list-item-title></p-list-item>
        <p-list-item><p-list-item-title>View accessibility</p-list-item-title></p-list-item>
        <p-list-item on:press="closeSheet"><p-list-item-title>Close</p-list-item-title></p-list-item>
    </p-bottom-sheet>
</AppScreen>
