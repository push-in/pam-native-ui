<AppScreen title="Activity" subtitle="A clear timeline of what changed">
    <Row class="items-center justify-between">
        <Text size="md">Today</Text>
        <p-badge variant="secondary"><Text>3 updates</Text></p-badge>
    </Row>

    <p-card class="rounded-2xl">
        <Column>
            <Row class="p-4 gap-3 items-start">
                <p-badge action="success"><p-icon icon="check" /></p-badge>
                <Column class="flex-1 gap-1">
                    <Row class="items-center justify-between">
                        <Text size="sm">Payment confirmed</Text>
                        <Text class="ui-text-muted">2m</Text>
                    </Row>
                    <Text class="ui-text-muted">Order #1048 · Credit card</Text>
                </Column>
            </Row>
            <p-divider />
            <Row class="p-4 gap-3 items-start">
                <p-badge action="info"><p-icon icon="share" /></p-badge>
                <Column class="flex-1 gap-1">
                    <Row class="items-center justify-between">
                        <Text size="sm">Order shipped</Text>
                        <Text class="ui-text-muted">48m</Text>
                    </Row>
                    <Text class="ui-text-muted">Order #1046 · Tracking sent</Text>
                </Column>
            </Row>
            <p-divider />
            <Row class="p-4 gap-3 items-start">
                <p-badge action="warning"><p-icon icon="schedule" /></p-badge>
                <Column class="flex-1 gap-1">
                    <Row class="items-center justify-between">
                        <Text size="sm">Payment pending</Text>
                        <Text class="ui-text-muted">1h</Text>
                    </Row>
                    <Text class="ui-text-muted">Order #1047 · Waiting for PIX</Text>
                </Column>
            </Row>
        </Column>
    </p-card>

    <Row class="items-center gap-3">
        <p-badge variant="secondary"><p-icon icon="chat" /></p-badge>
        <Column class="flex-1 gap-1">
            <Text size="sm">You are all caught up</Text>
            <Text class="ui-text-muted">New events will appear here automatically.</Text>
        </Column>
    </Row>
</AppScreen>
