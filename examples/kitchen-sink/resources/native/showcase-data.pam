<AppScreen title="Data" subtitle="Lists, tables and visualization">
    <template #actions><p-btn variant="text" on:press="openDrawer"><Text>Menu</Text></p-btn></template>
    <Column>

    <Text size="xl">Lists</Text>
        <p-list>
            <Text>Packages</Text>
            <p-list-item>
                <Text>pam-native-ui</Text>
                <Text>Material components</Text>
            </p-list-item>
            <p-list-item>
                <Text>pam-native</Text>
                <Text>Android and UIKit renderer</Text>
            </p-list-item>
        </p-list>

    <Text size="xl">Data table</Text>
        <p-data-table headers="Target" items="Android,iOS,Composer,GitHub" />

    <Text size="xl">Timeline</Text>
        <Column class="gap-4">
            <Row class="items-center gap-3">
                <p-avatar class="w-8 h-8"><Text>1</Text></p-avatar>
                <Column><Text>Design tokens</Text><Text size="sm">Theme and density foundations</Text></Column>
            </Row>
            <p-divider />
            <Row class="items-center gap-3">
                <p-avatar class="w-8 h-8"><Text>2</Text></p-avatar>
                <Column><Text>Native render</Text><Text size="sm">Android and UIKit parity</Text></Column>
            </Row>
            <p-divider />
            <Row class="items-center gap-3">
                <p-avatar class="w-8 h-8"><Text>3</Text></p-avatar>
                <Column><Text>Release</Text><Text size="sm">Validated package distribution</Text></Column>
            </Row>
        </Column>

    <Text size="xl">Visualization</Text>
        <Column class="gap-4">
            <p-sparkline value="18,32,29,44,68,61,82" accessibilityLabel="Weekly performance" />
            <p-treeview>
                <p-treeview-item path="/src"><Text>src</Text></p-treeview-item>
                <p-treeview-item path="/tests"><Text>tests</Text></p-treeview-item>
            </p-treeview>
        </Column>
    </Column>
</AppScreen>
