<AppScreen title="Orders" subtitle="284 orders · R$ 128,450 in revenue">
    <template #actions>
        <p-btn variant="outline" size="md" accessibilityLabel="Search orders">
            <p-icon icon="search" />
        </p-btn>
    </template>

    <p-row class="gap-2">
        <p-btn size="sm"><p-text>All</p-text></p-btn>
        <p-btn size="sm" variant="outline"><p-text>Paid</p-text></p-btn>
        <p-btn size="sm" variant="ghost"><p-text>Pending</p-text></p-btn>
    </p-row>

    <ContentState
        status="{{ $status }}"
        message="Orders could not be synchronized."
        @retry="retry"
    >
        <p-card class="rounded-2xl">
            <p-col>
                <p-col class="p-4 gap-2">
                    <p-row class="items-center justify-between gap-3">
                        <p-col class="gap-1">
                            <p-text size="md">Ana Martins</p-text>
                            <p-text class="ui-text-muted">#1048 · Today, 10:42</p-text>
                        </p-col>
                        <p-text size="md">R$ 389.00</p-text>
                    </p-row>
                    <p-row class="items-center gap-2">
                        <p-badge action="success"><p-text>Paid</p-text></p-badge>
                        <p-text class="ui-text-muted">Ready to fulfill</p-text>
                    </p-row>
                </p-col>
                <p-divider />
                <p-col class="p-4 gap-2">
                    <p-row class="items-center justify-between gap-3">
                        <p-col class="gap-1">
                            <p-text size="md">Lucas Costa</p-text>
                            <p-text class="ui-text-muted">#1047 · Today, 09:18</p-text>
                        </p-col>
                        <p-text size="md">R$ 149.90</p-text>
                    </p-row>
                    <p-row class="items-center gap-2">
                        <p-badge action="warning"><p-text>Pending</p-text></p-badge>
                        <p-text class="ui-text-muted">Waiting for PIX</p-text>
                    </p-row>
                </p-col>
                <p-divider />
                <p-col class="p-4 gap-2">
                    <p-row class="items-center justify-between gap-3">
                        <p-col class="gap-1">
                            <p-text size="md">Marina Alves</p-text>
                            <p-text class="ui-text-muted">#1046 · Yesterday</p-text>
                        </p-col>
                        <p-text size="md">R$ 829.00</p-text>
                    </p-row>
                    <p-row class="items-center gap-2">
                        <p-badge variant="secondary"><p-text>Shipped</p-text></p-badge>
                        <p-text class="ui-text-muted">Tracking sent</p-text>
                    </p-row>
                </p-col>
            </p-col>
        </p-card>
    </ContentState>

    <p-card class="p-4 rounded-2xl">
        <p-row class="items-center justify-between">
            <p-col class="gap-1">
                <p-text class="ui-text-muted">Average order</p-text>
                <p-text size="lg">R$ 452.29</p-text>
            </p-col>
            <p-badge variant="secondary"><p-text>+8.4%</p-text></p-badge>
        </p-row>
    </p-card>
</AppScreen>
