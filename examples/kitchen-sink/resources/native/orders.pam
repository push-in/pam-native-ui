<AppScreen title="Orders" subtitle="284 orders · R$ 128,450 in revenue">
    <template #actions>
        <p-btn variant="outline" size="md" accessibilityLabel="Search orders">
            <p-icon icon="search" />
        </p-btn>
    </template>

    <Row class="gap-2">
        <p-btn size="sm"><Text>All</Text></p-btn>
        <p-btn size="sm" variant="outline"><Text>Paid</Text></p-btn>
        <p-btn size="sm" variant="ghost"><Text>Pending</Text></p-btn>
    </Row>

    <ContentState
        status="{{ $status }}"
        message="Orders could not be synchronized."
        @retry="retry"
    >
        <p-card class="rounded-2xl">
            <Column>
                <Column class="p-4 gap-2">
                    <Row class="items-center justify-between gap-3">
                        <Column class="gap-1">
                            <Text size="md">Ana Martins</Text>
                            <Text class="ui-text-muted">#1048 · Today, 10:42</Text>
                        </Column>
                        <Text size="md">R$ 389.00</Text>
                    </Row>
                    <Row class="items-center gap-2">
                        <p-badge action="success"><Text>Paid</Text></p-badge>
                        <Text class="ui-text-muted">Ready to fulfill</Text>
                    </Row>
                </Column>
                <p-divider />
                <Column class="p-4 gap-2">
                    <Row class="items-center justify-between gap-3">
                        <Column class="gap-1">
                            <Text size="md">Lucas Costa</Text>
                            <Text class="ui-text-muted">#1047 · Today, 09:18</Text>
                        </Column>
                        <Text size="md">R$ 149.90</Text>
                    </Row>
                    <Row class="items-center gap-2">
                        <p-badge action="warning"><Text>Pending</Text></p-badge>
                        <Text class="ui-text-muted">Waiting for PIX</Text>
                    </Row>
                </Column>
                <p-divider />
                <Column class="p-4 gap-2">
                    <Row class="items-center justify-between gap-3">
                        <Column class="gap-1">
                            <Text size="md">Marina Alves</Text>
                            <Text class="ui-text-muted">#1046 · Yesterday</Text>
                        </Column>
                        <Text size="md">R$ 829.00</Text>
                    </Row>
                    <Row class="items-center gap-2">
                        <p-badge variant="secondary"><Text>Shipped</Text></p-badge>
                        <Text class="ui-text-muted">Tracking sent</Text>
                    </Row>
                </Column>
            </Column>
        </p-card>
    </ContentState>

    <p-card class="p-4 rounded-2xl">
        <Row class="items-center justify-between">
            <Column class="gap-1">
                <Text class="ui-text-muted">Average order</Text>
                <Text size="lg">R$ 452.29</Text>
            </Column>
            <p-badge variant="secondary"><Text>+8.4%</Text></p-badge>
        </Row>
    </p-card>
</AppScreen>
