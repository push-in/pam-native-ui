<AppScreen
    title="Workspace"
    subtitle="Sunday, July 26"
>
    <template #actions>
        <p-btn variant="outline" size="md" accessibilityLabel="Open notifications">
            <p-icon icon="notifications" />
        </p-btn>
    </template>
    <Column class="ui-bg gap-5">

    <p-card variant="tonal" class="p-5 rounded-3xl">
        <Column class="gap-4">
            <Row class="items-center justify-between">
                <Column class="gap-1">
                    <Text class="ui-text-muted">Net revenue</Text>
                    <Text size="xl" numberOfLines="1">R$ 128,450</Text>
                </Column>
                <p-badge action="success" variant="subtle">
                    <Text>+12.8%</Text>
                </p-badge>
            </Row>
            <p-progress-linear value="72" class="mt-2">
                
            </p-progress-linear>
            <Row class="items-center justify-between">
                    <Text size="sm" class="ui-text-muted" numberOfLines="1">Monthly target</Text>
                    <Text size="sm" numberOfLines="1">72% complete</Text>
            </Row>
        </Column>
    </p-card>

    <Row class="gap-3">
        <Column class="flex-1">
            <p-card class="p-4 rounded-2xl">
                <Column class="gap-2">
                    <Text class="ui-text-muted">Orders</Text>
                    <Text size="xl">284</Text>
                    <Text size="sm" class="text-blue-400" numberOfLines="1">+18 this week</Text>
                </Column>
            </p-card>
        </Column>
        <Column class="flex-1">
            <p-card class="p-4 rounded-2xl">
                <Column class="gap-2">
                    <Text class="ui-text-muted">Conversion</Text>
                    <Text size="xl">18.6%</Text>
                    <Text size="sm" class="text-blue-400" numberOfLines="1">+2.1 points</Text>
                </Column>
            </p-card>
        </Column>
    </Row>

    <Column class="gap-3">
        <Row class="items-center justify-between">
            <Column class="gap-1">
                <Text size="lg">Recent orders</Text>
                <Text class="ui-text-muted">Updated moments ago</Text>
            </Column>
            <p-btn variant="text" size="sm">
                <Text size="sm" numberOfLines="1">See all</Text>
            </p-btn>
        </Row>

        <p-card class="rounded-2xl">
            <Column>
                <Row class="p-4 items-center gap-3">
                    <p-avatar size="md">
                        <Column><Text>AM</Text></Column>
                    </p-avatar>
                    <Column class="flex-1 min-w-0 gap-1">
                        <Text size="sm" numberOfLines="1">Ana Martins</Text>
                        <Text size="sm" class="ui-text-muted" numberOfLines="1">#1048 · 2 items</Text>
                    </Column>
                    <Column class="w-24 items-end gap-1">
                        <Text size="sm" numberOfLines="1">R$ 389.00</Text>
                        <Row class="justify-end">
                            <p-badge action="success"><Text size="xs" numberOfLines="1">Paid</Text></p-badge>
                        </Row>
                    </Column>
                </Row>
                <p-divider />
                <Row class="p-4 items-center gap-3">
                    <p-avatar size="md">
                        <Column><Text>LC</Text></Column>
                    </p-avatar>
                    <Column class="flex-1 min-w-0 gap-1">
                        <Text size="sm" numberOfLines="1">Lucas Costa</Text>
                        <Text size="sm" class="ui-text-muted" numberOfLines="1">#1047 · 1 item</Text>
                    </Column>
                    <Column class="w-24 items-end gap-1">
                        <Text size="sm" numberOfLines="1">R$ 149.90</Text>
                        <Row class="justify-end">
                            <p-badge action="warning"><Text size="xs" numberOfLines="1">Pending</Text></p-badge>
                        </Row>
                    </Column>
                </Row>
            </Column>
        </p-card>
    </Column>

    <Row class="items-center gap-3">
        <p-badge action="success"><p-icon icon="check" /></p-badge>
        <Column class="flex-1 gap-1">
            <Text size="sm">All systems healthy</Text>
            <Text class="ui-text-muted">Native runtime · 60 FPS · 115 ms mount</Text>
        </Column>
    </Row>
    </Column>
</AppScreen>
