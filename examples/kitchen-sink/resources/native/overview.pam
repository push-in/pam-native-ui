<AppScreen
    title="Workspace"
    subtitle="Sunday, July 26"
>
    <template #actions>
        <p-btn variant="outline" size="md" accessibilityLabel="Open notifications">
            <p-icon icon="notifications" />
        </p-btn>
    </template>
    <p-col class="ui-bg gap-5">

    <p-card variant="tonal" class="p-5 rounded-3xl">
        <p-col class="gap-4">
            <p-row class="items-center justify-between">
                <p-col class="gap-1">
                    <p-text class="ui-text-muted">Net revenue</p-text>
                    <p-text size="xl" numberOfLines="1">R$ 128,450</p-text>
                </p-col>
                <p-badge action="success" variant="subtle">
                    <p-text>+12.8%</p-text>
                </p-badge>
            </p-row>
            <p-progress-linear value="72" class="mt-2">
                
            </p-progress-linear>
            <p-row class="items-center justify-between">
                    <p-text size="sm" class="ui-text-muted" numberOfLines="1">Monthly target</p-text>
                    <p-text size="sm" numberOfLines="1">72% complete</p-text>
            </p-row>
        </p-col>
    </p-card>

    <p-row class="gap-3">
        <p-col class="flex-1">
            <p-card class="p-4 rounded-2xl">
                <p-col class="gap-2">
                    <p-text class="ui-text-muted">Orders</p-text>
                    <p-text size="xl">284</p-text>
                    <p-text size="sm" class="text-blue-400" numberOfLines="1">+18 this week</p-text>
                </p-col>
            </p-card>
        </p-col>
        <p-col class="flex-1">
            <p-card class="p-4 rounded-2xl">
                <p-col class="gap-2">
                    <p-text class="ui-text-muted">Conversion</p-text>
                    <p-text size="xl">18.6%</p-text>
                    <p-text size="sm" class="text-blue-400" numberOfLines="1">+2.1 points</p-text>
                </p-col>
            </p-card>
        </p-col>
    </p-row>

    <p-col class="gap-3">
        <p-row class="items-center justify-between">
            <p-col class="gap-1">
                <p-text size="lg">Recent orders</p-text>
                <p-text class="ui-text-muted">Updated moments ago</p-text>
            </p-col>
            <p-btn variant="text" size="sm">
                <p-text size="sm" numberOfLines="1">See all</p-text>
            </p-btn>
        </p-row>

        <p-card class="rounded-2xl">
            <p-col>
                <p-row class="p-4 items-center gap-3">
                    <p-avatar size="md">
                        <p-col><p-text>AM</p-text></p-col>
                    </p-avatar>
                    <p-col class="flex-1 min-w-0 gap-1">
                        <p-text size="sm" numberOfLines="1">Ana Martins</p-text>
                        <p-text size="sm" class="ui-text-muted" numberOfLines="1">#1048 · 2 items</p-text>
                    </p-col>
                    <p-col class="w-24 items-end gap-1">
                        <p-text size="sm" numberOfLines="1">R$ 389.00</p-text>
                        <p-row class="justify-end">
                            <p-badge action="success"><p-text size="xs" numberOfLines="1">Paid</p-text></p-badge>
                        </p-row>
                    </p-col>
                </p-row>
                <p-divider />
                <p-row class="p-4 items-center gap-3">
                    <p-avatar size="md">
                        <p-col><p-text>LC</p-text></p-col>
                    </p-avatar>
                    <p-col class="flex-1 min-w-0 gap-1">
                        <p-text size="sm" numberOfLines="1">Lucas Costa</p-text>
                        <p-text size="sm" class="ui-text-muted" numberOfLines="1">#1047 · 1 item</p-text>
                    </p-col>
                    <p-col class="w-24 items-end gap-1">
                        <p-text size="sm" numberOfLines="1">R$ 149.90</p-text>
                        <p-row class="justify-end">
                            <p-badge action="warning"><p-text size="xs" numberOfLines="1">Pending</p-text></p-badge>
                        </p-row>
                    </p-col>
                </p-row>
            </p-col>
        </p-card>
    </p-col>

    <p-row class="items-center gap-3">
        <p-badge action="success"><p-icon icon="check" /></p-badge>
        <p-col class="flex-1 gap-1">
            <p-text size="sm">All systems healthy</p-text>
            <p-text class="ui-text-muted">Native runtime · 60 FPS · 115 ms mount</p-text>
        </p-col>
    </p-row>
    </p-col>
</AppScreen>
