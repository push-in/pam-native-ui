<AppScreen title="PAM Studio" subtitle="Inspect, tune and ship native products">
    <p-card class="p-5 rounded-3xl">
        <p-col class="gap-4">
            <p-row class="items-center justify-between">
                <p-col class="gap-1">
                    <p-text class="ui-text-muted">Runtime health</p-text>
                    <p-text size="xl">Production ready</p-text>
                </p-col>
                <p-badge action="success"><p-text>LIVE</p-text></p-badge>
            </p-row>
            <p-divider />
            <p-row class="gap-3">
                <p-col class="flex-1 min-w-0">
                    <p-col class="gap-1">
                        <p-text size="lg">60</p-text>
                        <p-text class="ui-text-muted">FPS</p-text>
                    </p-col>
                </p-col>
                <p-col class="flex-1 min-w-0">
                    <p-col class="gap-1">
                        <p-text size="lg">29 ms</p-text>
                        <p-text class="ui-text-muted">Decode</p-text>
                    </p-col>
                </p-col>
                <p-col class="flex-1 min-w-0">
                    <p-col class="gap-1">
                        <p-text size="lg">115 ms</p-text>
                        <p-text class="ui-text-muted">Mount</p-text>
                    </p-col>
                </p-col>
            </p-row>
        </p-col>
    </p-card>

    <p-col class="gap-3">
        <p-col class="gap-1">
            <p-text size="lg">Native playground</p-text>
            <p-text class="ui-text-muted">Real controls, rendered without a JavaScript runtime.</p-text>
        </p-col>
        <p-card class="p-4 rounded-2xl">
            <p-col class="gap-4">
                <p-row class="items-center justify-between">
                    <p-col class="gap-1">
                        <p-text size="sm">Motion and haptics</p-text>
                        <p-text class="ui-text-muted">Platform-aware feedback</p-text>
                    </p-col>
                    <p-switch checked="{{ $checked }}" on:change="toggle" />
                </p-row>
                <p-progress-linear value="{{ $progress }}" />
                <p-row class="gap-2">
                    <p-btn class="flex-1" on:press="toggleModal">
                        <p-text>Open modal</p-text>
                    </p-btn>
                    <p-btn class="flex-1" variant="outline" on:press="toggleSheet">
                        <p-text>Open sheet</p-text>
                    </p-btn>
                </p-row>
            </p-col>
        </p-card>
    </p-col>

    <p-col class="gap-3">
        <p-text size="lg">Product primitives</p-text>
        <p-col class="gap-3">
            <p-col>
                <p-card class="p-4 rounded-2xl">
                    <p-col class="gap-2">
                        <p-badge action="success"><p-icon icon="check" /></p-badge>
                        <p-text size="sm">Typed forms</p-text>
                        <p-text class="ui-text-muted">Rules, drafts and server errors.</p-text>
                    </p-col>
                </p-card>
            </p-col>
            <p-col>
                <p-card class="p-4 rounded-2xl">
                    <p-col class="gap-2">
                        <p-badge action="info"><p-icon icon="schedule" /></p-badge>
                        <p-text size="sm">Async states</p-text>
                        <p-text class="ui-text-muted">Loading through recovery.</p-text>
                    </p-col>
                </p-card>
            </p-col>
        </p-col>
    </p-col>

    <p-alert action="info" variant="subtle" class="rounded-2xl">
        <p-icon icon="info" />
        <p-col class="gap-1">
            <p-text>DevTools are one command away</p-text>
            <p-text class="ui-text-muted">pam mobile devtools .</p-text>
        </p-col>
    </p-alert>

    <p-btn on:press="openComponents" class="w-full">
        <p-icon icon="widgets" />
        <p-text>Explore all native components</p-text>
    </p-btn>

    <p-dialog open="{{ $modalOpen }}" on:event="closeModal">

        <p-card>
            <p-card-title>
                <p-text size="lg">Native by default</p-text>
                <p-icon-btn on:press="closeModal"><p-icon icon="close" /></p-icon-btn>
            </p-card-title>
            <p-card-text>
                <p-text>Focus, Back and accessibility remain owned by the platform.</p-text>
            </p-card-text>
            <p-card-actions>
                <p-btn on:press="closeModal"><p-text>Got it</p-text></p-btn>
            </p-card-actions>
        </p-card>
    </p-dialog>

    <p-bottom-sheet
        open="{{ $sheetOpen }}"
        snapPoints="30,55"
        snapToIndex="1"
        on:event="closeSheet"
    >
        <p-divider />
        <p-list-item on:press="closeSheet"><p-list-item-title>Inspect tree</p-list-item-title></p-list-item>
        <p-list-item on:press="closeSheet"><p-list-item-title>View metrics</p-list-item-title></p-list-item>
        <p-list-item on:press="closeSheet"><p-list-item-title>Close</p-list-item-title></p-list-item>
    </p-bottom-sheet>
</AppScreen>
