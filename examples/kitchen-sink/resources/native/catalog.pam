<AppScreen title="PAM Studio" subtitle="Inspect, tune and ship native products">
    <p-card class="p-5 rounded-3xl">
        <Column class="gap-4">
            <Row class="items-center justify-between">
                <Column class="gap-1">
                    <Text class="ui-text-muted">Runtime health</Text>
                    <Text size="xl">Production ready</Text>
                </Column>
                <p-badge action="success"><Text>LIVE</Text></p-badge>
            </Row>
            <p-divider />
            <Row class="gap-3">
                <Column class="flex-1 min-w-0">
                    <Column class="gap-1">
                        <Text size="lg">60</Text>
                        <Text class="ui-text-muted">FPS</Text>
                    </Column>
                </Column>
                <Column class="flex-1 min-w-0">
                    <Column class="gap-1">
                        <Text size="lg">29 ms</Text>
                        <Text class="ui-text-muted">Decode</Text>
                    </Column>
                </Column>
                <Column class="flex-1 min-w-0">
                    <Column class="gap-1">
                        <Text size="lg">115 ms</Text>
                        <Text class="ui-text-muted">Mount</Text>
                    </Column>
                </Column>
            </Row>
        </Column>
    </p-card>

    <Column class="gap-3">
        <Column class="gap-1">
            <Text size="lg">Native playground</Text>
            <Text class="ui-text-muted">Real controls, rendered without a JavaScript runtime.</Text>
        </Column>
        <p-card class="p-4 rounded-2xl">
            <Column class="gap-4">
                <Row class="items-center justify-between">
                    <Column class="gap-1">
                        <Text size="sm">Motion and haptics</Text>
                        <Text class="ui-text-muted">Platform-aware feedback</Text>
                    </Column>
                    <p-switch checked="{{ $checked }}" on:change="toggle" />
                </Row>
                <p-progress-linear value="{{ $progress }}" />
                <Row class="gap-2">
                    <p-btn class="flex-1" on:press="toggleModal">
                        <Text>Open modal</Text>
                    </p-btn>
                    <p-btn class="flex-1" variant="outline" on:press="toggleSheet">
                        <Text>Open sheet</Text>
                    </p-btn>
                </Row>
            </Column>
        </p-card>
    </Column>

    <Column class="gap-3">
        <Text size="lg">Product primitives</Text>
        <Column class="gap-3">
            <Column>
                <p-card class="p-4 rounded-2xl">
                    <Column class="gap-2">
                        <p-badge action="success"><p-icon icon="check" /></p-badge>
                        <Text size="sm">Typed forms</Text>
                        <Text class="ui-text-muted">Rules, drafts and server errors.</Text>
                    </Column>
                </p-card>
            </Column>
            <Column>
                <p-card class="p-4 rounded-2xl">
                    <Column class="gap-2">
                        <p-badge action="info"><p-icon icon="schedule" /></p-badge>
                        <Text size="sm">Async states</Text>
                        <Text class="ui-text-muted">Loading through recovery.</Text>
                    </Column>
                </p-card>
            </Column>
        </Column>
    </Column>

    <p-alert action="info" variant="subtle" class="rounded-2xl">
        <p-icon icon="info" />
        <Column class="gap-1">
            <Text>DevTools are one command away</Text>
            <Text class="ui-text-muted">pam mobile devtools .</Text>
        </Column>
    </p-alert>

    <p-btn on:press="openComponents" class="w-full">
        <p-icon icon="widgets" />
        <Text>Explore all native components</Text>
    </p-btn>

    <p-dialog open="{{ $modalOpen }}" on:event="closeModal">

        <p-card>
            <p-card-title>
                <Text size="lg">Native by default</Text>
                <p-icon-btn on:press="closeModal"><p-icon icon="close" /></p-icon-btn>
            </p-card-title>
            <p-card-text>
                <Text>Focus, Back and accessibility remain owned by the platform.</Text>
            </p-card-text>
            <p-card-actions>
                <p-btn on:press="closeModal"><Text>Got it</Text></p-btn>
            </p-card-actions>
        </p-card>
    </p-dialog>

    <p-bottom-sheet
        open="{{ $sheetOpen }}"
        snapPoints="30,55"
        snapToIndex="1"
        on:event="closeSheet"
    >
        <p-divider />
        <p-list-item on:press="closeSheet"><p-list-item-title>Inspect tree</p-list-item-title></p-list-item>
        <p-list-item on:press="closeSheet"><p-list-item-title>View metrics</p-list-item-title></p-list-item>
        <p-list-item on:press="closeSheet"><p-list-item-title>Close</p-list-item-title></p-list-item>
    </p-bottom-sheet>
</AppScreen>
