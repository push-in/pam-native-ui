<AppScreen title="Forms" subtitle="Thoughtful inputs for real product flows">
    <template #actions><p-btn variant="text" on:press="openDrawer"><Text>Menu</Text></p-btn></template>

    <Column class="gap-2">
        <Text size="2xl" class="font-bold">Shape your next native product.</Text>
        <Text class="ui-text-muted">Clear hierarchy, calm focus and feedback exactly where it matters.</Text>
    </Column>

    <Column class="gap-2">
        <Row class="items-center gap-3">
            <p-icon icon="edit" color="secondary" />
            <Text size="xl" class="font-semibold">Workspace identity</Text>
        </Row>
        <Text size="sm" class="ui-text-muted">The essentials, without visual noise.</Text>
    </Column>
    <Column class="gap-4">
        <p-text-field label="Project name" value="Aurora" focused="true" helper="This name is available" variant="outlined" />
        <p-text-field label="Owner" value="Design systems team" variant="outlined" />
        <p-textarea label="Product brief" value="A fast, inclusive mobile experience built with native controls." rows="3" variant="outlined" />
    </Column>

    <Column class="gap-2">
        <Row class="items-center gap-3">
            <p-icon icon="search" color="info" />
            <Text size="xl" class="font-semibold">Discover and organize</Text>
        </Row>
        <Text size="sm" class="ui-text-muted">Searchable choices stay aligned with ordinary fields.</Text>
    </Column>
    <Column class="gap-4">
        <p-autocomplete label="Starting template" value="Commerce" items="Commerce,Community,Productivity,Media" variant="outlined" />
        <p-combobox label="Capabilities" value="Payments" items="Payments,Realtime,Media,Maps" variant="outlined" />
        <p-select label="Primary platform" value="Android" items="Android,iOS" variant="outlined" />
    </Column>

    <Column class="gap-2">
        <Row class="items-center gap-3">
            <p-icon icon="calendar-days" color="warning" />
            <Text size="xl" class="font-semibold">Brand and release</Text>
        </Row>
        <Text size="sm" class="ui-text-muted">Typed values retain native editing and validation.</Text>
    </Column>
    <Column class="gap-4">
        <p-color-input label="Brand accent" value="#6C4FF8" variant="outlined" />
        <p-date-input label="Target release" value="2026-09-24" variant="outlined" />
    </Column>

    <Column class="gap-2">
        <Row class="items-center gap-3">
            <p-icon icon="check-circle" color="primary" />
            <Text size="xl" class="font-semibold">Delivery preferences</Text>
        </Row>
        <Text size="sm" class="ui-text-muted">Every option keeps a complete 48dp interaction target.</Text>
    </Column>
    <Column class="gap-2">
        <p-checkbox label="Run accessibility checks" checked="true" />
        <p-radio label="Stable release channel" checked="true" />
        <p-switch label="Automatic native previews" checked="true" />
    </Column>

    <Column class="gap-2">
        <Row class="items-center gap-3">
            <p-icon icon="repeat" color="secondary" />
            <Text size="xl" class="font-semibold">Tune the experience</Text>
        </Row>
        <Text size="sm" class="ui-text-muted">Continuous controls remain smooth and readable.</Text>
    </Column>
    <Column class="gap-4">
        <Text size="sm" class="ui-text-muted">Motion intensity · 68%</Text>
        <p-slider value="68" accessibilityLabel="Motion intensity" />
        <Text size="sm" class="ui-text-muted">Supported price range · 24 to 76</Text>
        <p-range-slider value="24" maximumValue="76" accessibilityLabel="Supported price range" />
    </Column>
</AppScreen>
