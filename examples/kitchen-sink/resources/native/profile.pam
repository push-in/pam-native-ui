<AppScreen title="Profile" subtitle="Your identity across PAM products">
    <p-card class="p-4 rounded-2xl">
        <Row class="gap-4 items-center">
            <p-avatar size="xl">
                <Column>
                    <Text>DB</Text>
                </Column>
                <p-badge />
            </p-avatar>
            <Column class="flex-1 gap-1">
                <Row class="items-center gap-2">
                    <Text size="md">David Balbino</Text>
                    <p-badge action="success"><Text>Active</Text></p-badge>
                </Row>
                <Text class="ui-text-muted">Product builder · Pushin</Text>
            </Column>
        </Row>
    </p-card>

    <Column class="gap-3">
        <Text size="md">Account details</Text>
        <p-text-field
            :form="$form"
            field="name"
            label="Name"
            placeholder="Your full name"
            autoComplete="name"
        />
        <p-text-field
            :form="$form"
            field="email"
            label="Email"
            helper="Used for account recovery and release notifications."
            keyboard="2"
            autoComplete="email"
        />
        <p-text-field
            :form="$form"
            field="company"
            label="Company"
            placeholder="Your organization"
            returnKey="3"
        />
        <p-btn
            label="Save profile"
            status="{{ $actionStatus }}"
            on:press="save"
        />
    </Column>

    <Text class="ui-text-muted">
        Changes are validated as you type and saved securely on this device.
    </Text>
</AppScreen>
