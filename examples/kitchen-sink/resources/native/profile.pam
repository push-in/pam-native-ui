<AppScreen title="Profile" subtitle="Your identity across PAM products">
    <p-card class="p-4 rounded-2xl">
        <p-row class="gap-4 items-center">
            <p-avatar size="xl">
                <p-col>
                    <p-text>DB</p-text>
                </p-col>
                <p-badge />
            </p-avatar>
            <p-col class="flex-1 gap-1">
                <p-row class="items-center gap-2">
                    <p-text size="md">David Balbino</p-text>
                    <p-badge action="success"><p-text>Active</p-text></p-badge>
                </p-row>
                <p-text class="ui-text-muted">Product builder · Pushin</p-text>
            </p-col>
        </p-row>
    </p-card>

    <p-col class="gap-3">
        <p-text size="md">Account details</p-text>
        <p-text-field
            :form="$form"
            field="name"
            label="Name"
            placeholder="Your full name"
            autoComplete="name"
        />
        <p-text-field
            :form="$form"
            field="email"
            label="Email"
            helper="Used for account recovery and release notifications."
            keyboard="2"
            autoComplete="email"
        />
        <p-text-field
            :form="$form"
            field="company"
            label="Company"
            placeholder="Your organization"
            returnKey="3"
        />
        <p-btn
            label="Save profile"
            status="{{ $actionStatus }}"
            on:press="save"
        />
    </p-col>

    <p-text class="ui-text-muted">
        Changes are validated as you type and saved securely on this device.
    </p-text>
</AppScreen>
