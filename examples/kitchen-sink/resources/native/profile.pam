<AppScreen title="Profile" subtitle="Typed form state with native editing behavior.">
    <Card class="p-5 rounded-2xl">
        <VStack class="gap-4 items-center">
            <Avatar size="xl">
                <AvatarFallback>
                    <AvatarFallbackText>DB</AvatarFallbackText>
                </AvatarFallback>
                <AvatarBadge />
            </Avatar>
            <VStack class="items-center gap-1">
                <Heading size="lg">David Balbino</Heading>
                <Text class="ui-text-muted">PAM Native builder</Text>
            </VStack>
        </VStack>
    </Card>

    <VStack class="gap-4">
        <FormField
            :form="$form"
            field="name"
            label="Name"
            placeholder="Your full name"
            autoComplete="name"
        />
        <FormField
            :form="$form"
            field="email"
            label="Email"
            helper="Used for account recovery and release notifications."
            keyboard="2"
            autoComplete="email"
        />
        <FormField
            :form="$form"
            field="company"
            label="Company"
            placeholder="Your organization"
            returnKey="3"
        />
        <AsyncButton
            label="Save profile"
            status="{{ $actionStatus }}"
            on:press="save"
        />
    </VStack>

    <Alert action="info" variant="subtle" class="rounded-2xl">
        <InfoIcon />
        <AlertText>
            Validation runs on blur. Drafts survive process restarts.
        </AlertText>
    </Alert>
</AppScreen>
