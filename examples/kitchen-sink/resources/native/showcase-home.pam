<AppScreen title="PAM Native UI" subtitle="A native design system for PHP">
    <template #actions>
        <Pressable class="w-12 h-12 rounded-full items-center justify-center" on:press="openDrawer" accessibilityRole="button" accessibilityLabel="Open component navigation">
            <p-icon icon="menu" color="primary" />
        </Pressable>
    </template>

    <p-card color="secondary" variant="filled" class="p-5 rounded-3xl">
        <Column class="gap-5">
            <Row class="items-center justify-between gap-3">
                <p-chip action="success" variant="subtle">
                    <p-icon icon="check" />
                    <Text>ANDROID READY</Text>
                </p-chip>
                <Text size="sm" class="text-white">Native · zero JS</Text>
            </Row>

            <Column class="gap-2">
                <Text size="3xl" class="text-white font-bold">Interfaces that feel at home.</Text>
                <Text size="base" class="text-white">
                    Typed PHP, real platform controls and a complete product system for Android and iOS.
                </Text>
            </Column>

            <Row class="gap-4">
                <Column class="flex-1 gap-1">
                    <Text size="2xl" class="text-white font-bold">84</Text>
                    <Text size="sm" class="text-white">components</Text>
                </Column>
                <Column class="flex-1 gap-1">
                    <Text size="2xl" class="text-white font-bold">2</Text>
                    <Text size="sm" class="text-white">native targets</Text>
                </Column>
                <Column class="flex-1 gap-1">
                    <Text size="2xl" class="text-white font-bold">0</Text>
                    <Text size="sm" class="text-white">JS bridges</Text>
                </Column>
            </Row>

            <p-btn block="true" on:press="goAll">
                <p-icon icon="settings" />
                <Text>Browse all components</Text>
            </p-btn>
        </Column>
    </p-card>

    <Column class="gap-3">
        <Column class="gap-1">
            <Text size="xl" class="font-semibold">Component workbench</Text>
            <Text size="sm" class="text-muted-foreground">Explore real native interactions by product family.</Text>
        </Column>

        <p-list>
            <p-list-item lines="two" on:press="goActions">
                <p-icon icon="play" color="primary" />
                <Column>
                    <Text size="base" class="font-medium">Actions</Text>
                    <Text size="sm" class="text-muted-foreground">Buttons, chips and selection</Text>
                </Column>
                <p-icon icon="chevron-right" />
            </p-list-item>
            <p-divider />
            <p-list-item lines="two" on:press="goForms">
                <p-icon icon="edit" color="secondary" />
                <Column>
                    <Text size="base" class="font-medium">Forms</Text>
                    <Text size="sm" class="text-muted-foreground">Inputs, pickers and validation</Text>
                </Column>
                <p-icon icon="chevron-right" />
            </p-list-item>
            <p-divider />
            <p-list-item lines="two" on:press="goData">
                <p-icon icon="calendar-days" color="info" />
                <Column>
                    <Text size="base" class="font-medium">Data</Text>
                    <Text size="sm" class="text-muted-foreground">Tables, lists and visualization</Text>
                </Column>
                <p-icon icon="chevron-right" />
            </p-list-item>
            <p-divider />
            <p-list-item lines="two" on:press="goOverlays">
                <p-icon icon="copy" color="warning" />
                <Column>
                    <Text size="base" class="font-medium">Overlays</Text>
                    <Text size="sm" class="text-muted-foreground">Dialogs, sheets and menus</Text>
                </Column>
                <p-icon icon="chevron-right" />
            </p-list-item>
        </p-list>
    </Column>

    <p-alert action="info" variant="subtle" class="rounded-2xl">
        <Column class="gap-1">
            <Text class="font-medium">Accessible by contract</Text>
            <Text size="sm" class="text-muted-foreground">48 dp targets, dynamic text, screen readers and reduced motion are validated before release.</Text>
        </Column>
    </p-alert>
</AppScreen>
