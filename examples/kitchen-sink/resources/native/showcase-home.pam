<AppScreen title="PAM UI" subtitle="Native component showcase">
        <template #actions>
            <p-btn variant="text" on:press="openDrawer" accessibilityLabel="Open component menu"><Text>Menu</Text></p-btn>
        </template>
        <Column class="gap-3 py-2">
            <p-chip variant="tonal"><Text>Material for native</Text></p-chip>
            <Text size="2xl">One system. Two platforms.</Text>
            <Text>Explore every p-* component as real Android and UIKit views.</Text>
        </Column>
        <Text size="xl">Browse by category</Text>
        <p-list>
            <p-list-item on:press="goActions"><p-list-item-title>Actions</p-list-item-title><p-list-item-subtitle>Buttons, chips and selection</p-list-item-subtitle></p-list-item>
            <p-divider />
            <p-list-item on:press="goForms"><p-list-item-title>Forms</p-list-item-title><p-list-item-subtitle>Inputs, pickers and validation</p-list-item-subtitle></p-list-item>
            <p-divider />
            <p-list-item on:press="goData"><p-list-item-title>Data</p-list-item-title><p-list-item-subtitle>Tables, lists and visualization</p-list-item-subtitle></p-list-item>
            <p-divider />
            <p-list-item on:press="goOverlays"><p-list-item-title>Overlays</p-list-item-title><p-list-item-subtitle>Dialogs, sheets and menus</p-list-item-subtitle></p-list-item>
        </p-list>
        <p-btn block="true" on:press="goAll"><Text>Explore all components</Text></p-btn>
</AppScreen>
