<?php

declare(strict_types=1);

namespace App\Screens;

use Pam\Native\Attributes\State;
use Pam\Native\Component;

final class Overlays extends Component
{
    #[State] public bool $sheet = false;
    #[State] public bool $dialog = false;
    #[State] public bool $snackbar = false;
    #[State] public string $sort = 'recent';
    #[State] public bool $unread = false;
    /** @var list<string> */
    #[State] public array $events = [];

    public function log(string $event): void { $this->events = [...array_slice($this->events, -3), $event]; }
    public function openSheet(): void { $this->sheet = true; }
    public function openDialog(): void { $this->dialog = true; }
    public function showSnackbar(): void { $this->snackbar = true; }
    public function sheetClosed(): void { $this->log('sheet.close'); }

    public function apply(): void
    {
        $this->sheet = false;
        $this->log('sheet.apply:'.$this->sort.($this->unread ? ':unread' : ''));
        $this->snackbar = true;
    }

    public function deleted(): void { $this->log('dialog.confirm'); }
    public function cancelled(): void { $this->log('dialog.cancel'); }
    public function undo(): void { $this->log('snackbar.action'); }

    public function state(): string
    {
        return json_encode([
            'events' => $this->events,
            'sheet' => $this->sheet,
            'dialog' => $this->dialog,
            'snackbar' => $this->snackbar,
            'sort' => $this->sort,
            'unread' => $this->unread,
        ], JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR);
    }
    public function back(): void { $this->popRoute(); }
}
?>

<template>
    <p-screen title="Overlays" back="true" @back="back">
        <p-card title="Bottom sheet" subtitle="Drag, swipe or tap outside to close.">
            <p-btn variant="tonal" label="Open filters" testId="open-sheet" @press="openSheet" />
        </p-card>
        <p-card title="Dialog" subtitle="A confirmation with a destructive action.">
            <p-btn variant="tonal" label="Delete project" testId="open-dialog" @press="openDialog" />
        </p-card>
        <p-card title="Snackbar" subtitle="Hides itself after 4 seconds.">
            <p-btn variant="tonal" label="Show snackbar" testId="open-snackbar" @press="showSnackbar" />
        </p-card>

        <p-sheet p-model="$sheet" title="Filters" @close="sheetClosed">
            <p-radio-group p-model="$sort" label="Sort by" :options="['recent' => 'Most recent', 'popular' => 'Most popular', 'name' => 'Name']" />
            <p-switch p-model="$unread" label="Unread only" />
            <template #footer>
                <p-btn label="Apply" block="true" testId="apply-sheet" @press="apply" />
            </template>
        </p-sheet>
        <p-dialog p-model="$dialog" title="Delete project?" text="This removes the project and its history. It cannot be undone." confirmLabel="Delete" destructive="true" @confirm="deleted" @cancel="cancelled" />
        <p-snackbar p-model="$snackbar" text="Changes saved" actionLabel="Undo" @action="undo" />
        <template #footer>
            <Text class="log" testID="php-state">{{ state() }}</Text>
        </template>
    </p-screen>
</template>

<style scoped>
    .log { font-family: monospace; font-size: 12px; line-height: 18px; color: #1B1B18; }
    @media (prefers-color-scheme: dark) { .log { color: #EDEDEC; } }
</style>
