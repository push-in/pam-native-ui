{
    "name": "pushinbr/pam-native-ui-showcase",
    "description": "PAM Native UI 2 showcase: every component, form and theme on Android and iOS.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.5",
        "pushinbr/pam-native": "^1.53.9",
        "pushinbr/pam-native-ui": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        },
        "platform-check": true,
        "sort-packages": true
    }
}
