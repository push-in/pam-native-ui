{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "reference",
        "targetDefinitions",
        "gateDefinitions",
        "statusDefinitions",
        "modules"
    ],
    "properties": {
        "$schema": {"type": "string"},
        "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "source",
                "namespace",
                "metadataImport",
                "moduleCount",
                "componentCount",
                "targets"
            ],
            "properties": {
                "source": {"const": "resources/pam-material-components.php"},
                "namespace": {"const": "p-*"},
                "metadataImport": {"const": false},
                "moduleCount": {"const": 62},
                "componentCount": {"const": 84},
                "targets": {
                    "type": "array",
                    "prefixItems": [{"const": 1}, {"const": 2}],
                    "items": false
                }
            }
        },
        "targetDefinitions": {
            "type": "array",
            "prefixItems": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "name"],
                    "properties": {"id": {"const": 1}, "name": {"const": "android"}}
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "name"],
                    "properties": {"id": {"const": 2}, "name": {"const": "ios"}}
                }
            ],
            "items": false
        },
        "gateDefinitions": {
            "type": "array",
            "minItems": 12,
            "maxItems": 12,
            "items": {"$ref": "#/$defs/sequentialDefinition"}
        },
        "statusDefinitions": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"$ref": "#/$defs/sequentialDefinition"}
        },
        "modules": {
            "type": "array",
            "minItems": 62,
            "maxItems": 62,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "module", "components", "verification"],
                "properties": {
                    "type": {"type": "integer", "minimum": 1, "maximum": 62},
                    "module": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
                    "components": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {"type": "string", "pattern": "^p-[a-z][a-z0-9-]*$"}
                    },
                    "verification": {
                        "type": "array",
                        "minItems": 12,
                        "maxItems": 12,
                        "items": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 4
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "sequentialDefinition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
                "id": {"type": "integer", "minimum": 1},
                "name": {"type": "string", "minLength": 1}
            }
        }
    }
}
